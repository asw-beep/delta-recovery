# ─── Razorpay (Test Mode) ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Database (Supabase Postgres) ────────────────────────────────
# Use the Session pooler / direct connection string from Supabase
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ─── LLM: Gemini primary, Groq fallback ──────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Delta <onboarding@resend.dev>"

# ─── App ─────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=
# Cap on real Razorpay payment links; the rest of a batch runs as SIM.
LIVE_ACTION_BUDGET=12
